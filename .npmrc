# El bundle de servidor que genera Astro 7 importa dependencias externas
# (p. ej. `cookie`) que el enlazado estricto de pnpm no resuelve desde el
# artefacto ya construido: el build falla con
# "Named export 'parseCookie' not found".
# Con node_modules plano se resuelven correctamente.
node-linker=hoisted
