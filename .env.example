# Copia este archivo como .env y rellena los valores.
# El .env real NUNCA se sube al repositorio.

# API key de Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Remitente. OJO: no puede ser una cuenta de Gmail — Resend solo permite
# enviar desde un dominio propio verificado (SPF + DKIM). El destinatario
# sí puede ser Gmail; el remitente no.
CONTACT_FROM_EMAIL="Citas <citas@bereniceparada.com>"

# Bandeja donde la doctora recibe las solicitudes de cita.
CONTACT_TO_EMAIL=cbparada03@gmail.com

# ---------------------------------------------------------------------------
# Panel de administración (/admin)
# ---------------------------------------------------------------------------

# Proyecto Supabase. La URL y la publishable key no son secretas, pero tampoco
# se exponen al navegador: aquí no hay ningún cliente Supabase en el cliente.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# SECRETA. Bypasa RLS. Solo se usa desde /api/*, nunca desde una página.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Correos con acceso al panel, separados por comas. Segunda barrera además de
# la tabla `admins`: sin estar en las dos listas no se entra.
ADMIN_EMAILS=cbparada03@gmail.com

# Mínimo 32 caracteres. Vercel lo manda como `Authorization: Bearer …` al cron
# que evita que Supabase pause el proyecto por inactividad.
# Generar con: openssl rand -hex 32
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
