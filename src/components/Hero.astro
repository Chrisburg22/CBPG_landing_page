---
import { doctor } from '@/config/site';
---

<section class="hero" id="top">
  <div class="wrap">
    <div class="meta-row hero__top reveal">
      <span>Especialista en ortodoncia</span>
      <span>Guadalajara, Jalisco</span>
      <span>{doctor.yearsExperience} años de práctica</span>
    </div>

    {/* Cada línea va en su propia máscara: al entrar suben por separado. */}
    <h1 class="hero__title reveal">
      <span class="hero__line"><span>Una sonrisa alineada,</span></span>
      <span class="hero__line"><span><em>diseñada</em> para ti.</span></span>
    </h1>

    <div class="hero__bottom">
      <p class="hero__sub reveal">
        Tratamientos de ortodoncia de precisión para adultos y adolescentes.
        Alineadores invisibles, brackets estéticos y planes pensados para tu
        ritmo de vida.
      </p>

      <div class="hero__actions reveal">
        <a href="#contacto" class="btn btn--primary">Reservar valoración</a>
        <a href="#tratamientos" class="btn btn--ghost">Ver tratamientos</a>
      </div>
    </div>

    <p class="figcap hero__figcap reveal">
      Valoración inicial · diagnóstico y plan personalizado
    </p>
  </div>
</section>
