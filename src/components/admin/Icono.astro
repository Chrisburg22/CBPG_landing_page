---
/**
 * Iconos del panel: un solo juego, trazo de 1.6 sobre rejilla de 24.
 *
 * Siempre decorativos (`aria-hidden`): el texto de al lado es lo que se lee. Un
 * botón que solo lleve icono tiene que traer su propio `aria-label`.
 */
interface Props {
  nombre: keyof typeof TRAZOS;
  /** 16 para dentro de botones y chips; 20 por defecto. */
  tam?: 16 | 20 | 24;
}

const TRAZOS = {
  inicio: '<path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/>',
  agenda: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17M8 3.5v3M16 3.5v3"/>',
  prospecto: '<path d="M5 4h11l3 3v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/><path d="M8 11h8M8 15h5"/>',
  paciente: '<circle cx="12" cy="8" r="3.4"/><path d="M5 20c.6-3.7 3.4-5.6 7-5.6s6.4 1.9 7 5.6"/>',
  pago: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M6.5 14.5h3"/>',
  whatsapp: '<path d="M20 12a8 8 0 0 1-11.9 7L4 20l1.1-4A8 8 0 1 1 20 12z"/><path d="M9 10c.5 2 2 3.5 5 5"/>',
  telefono: '<path d="M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5L16 14l4 1.5V19a1 1 0 0 1-1 1A15 15 0 0 1 4 5a1 1 0 0 1 1-1z"/>',
  mas: '<path d="M12 5v14M5 12h14"/>',
  hecho: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  reloj: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4.5l3 2"/>',
  izquierda: '<path d="m14.5 6-6 6 6 6"/>',
  derecha: '<path d="m9.5 6 6 6-6 6"/>',
  buscar: '<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>',
  alerta: '<path d="M12 4 3 19.5h18z"/><path d="M12 10v4.5M12 17.2v.3"/>',
  sincronizar: '<path d="M19 8a7.5 7.5 0 0 0-13.3-1.5M5 16a7.5 7.5 0 0 0 13.3 1.5"/><path d="M19 3.5V8h-4.5M5 20.5V16h4.5"/>',
  dinero: '<rect x="3" y="6.5" width="18" height="11" rx="2"/><circle cx="12" cy="12" r="2.6"/>',
  convertir: '<circle cx="10" cy="8" r="3.4"/><path d="M3.5 20c.6-3.7 3-5.6 6.5-5.6 1.6 0 3 .4 4 1.1M18 13v6M15 16h6"/>',
  nota: '<path d="M5 4h14v12l-4 4H5z"/><path d="M15 20v-4h4M8.5 9h7M8.5 12.5h4"/>',
  flecha: '<path d="M5 12h13M13 6.5 18.5 12 13 17.5"/>',
  abajo: '<path d="m6 9.5 6 6 6-6"/>',
  aviso: '<path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2.2 2.2 0 0 0 4 0"/>',
  cerrar: '<path d="m6.5 6.5 11 11M17.5 6.5l-11 11"/>',
  filtro: '<path d="M4 6h16M7 12h10M10 18h4"/>',
} as const;

const { nombre, tam = 20 } = Astro.props as Props;
---

<svg
  class="icono"
  width={tam}
  height={tam}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  set:html={TRAZOS[nombre]}
/>
