---
import { treatments } from '@/config/site';

// Índice, no tarjetas: cada tratamiento es una fila con número, nombre,
// explicación y una flecha. Se lee de un vistazo y pesa mucho menos que
// cinco recuadros con iconos.
const numero = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="section" id="tratamientos">
  <div class="wrap">
    <div class="meta-row reveal">
      <span>(02) Tratamientos</span>
      <span>{treatments.length} opciones · un mismo objetivo</span>
    </div>

    <div class="section__head reveal">
      <h2>Opciones para cada sonrisa y cada estilo de vida.</h2>
      <p>
        Cada plan comienza con una valoración y un diagnóstico digital. Elegimos
        juntos la técnica que mejor se ajusta a tus objetivos.
      </p>
    </div>

    <div class="tindex reveal">
      {treatments.map((t, i) => (
        <a class="tindex__row" href="#contacto">
          <span class="tindex__num">{numero(i)}</span>
          <h3>
            {t.title}
            <span class="tindex__tag">{t.tag}</span>
          </h3>
          <p class="tindex__desc">{t.description}</p>
          <span class="tindex__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>

    <div class="cta-band reveal">
      <p>¿No sabes cuál elegir?</p>
      <a href="#contacto" class="btn btn--inverso">Agendar valoración</a>
    </div>
  </div>
</section>
