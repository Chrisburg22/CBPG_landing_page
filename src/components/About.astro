---
import { Image } from 'astro:assets';
import { doctor } from '@/config/site';

const titulaciones = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/doctora-titulacion.{jpg,jpeg,png,webp}',
  { eager: true }
);
const titulacion = Object.values(titulaciones)[0]?.default;

const formacion = [
  'Especialista certificada en Ortodoncia y Ortopedia Maxilar.',
  'Escaneo intraoral digital — sin moldes incómodos.',
  'Planes de pago flexibles y citas que se adaptan a ti.',
];
---

<section class="section" id="sobre">
  <div class="wrap">
    <div class="meta-row reveal">
      <span>(01) Sobre la doctora</span>
      <span>Formación · enfoque · trato</span>
    </div>

    <div class="about__grid">
      {/* La foto manda: ocupa más que el texto, va montada sobre papel y se
          acerca despacio al recorrer la sección. */}
      <figure class="about__media reveal" data-foto data-zoom="0.05" data-parallax="0.03">
        <div class="about__ventana">
          {titulacion ? (
            <Image
              src={titulacion}
              alt={`La Dra. ${doctor.name} el día de su titulación como especialista, en la Universidad de Guadalajara`}
              widths={[500, 800, 1100]}
              sizes="(max-width: 1024px) 92vw, 52vw"
              loading="lazy"
            />
          ) : (
            <div class="ph"><span class="ph__label">foto · doctora en consulta</span></div>
          )}
        </div>
        <figcaption class="about__sello">
          Dra. {doctor.name} · {doctor.specialty}
        </figcaption>
      </figure>

      <div class="about__body reveal">
        <h2 class="about__lead">
          Cuido cada detalle como si fuera <em>mi propia</em> sonrisa.
        </h2>

        <p class="about__text">
          Soy la <strong>Dra. {doctor.name}</strong>, especialista en ortodoncia con más de una
          década acompañando a mis pacientes en su transformación. Combino tecnología de diagnóstico
          digital con un trato cercano para que el proceso sea claro, cómodo y a tu medida.
        </p>

        <ul class="creds">
          {formacion.map((dato, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              {dato}
            </li>
          ))}
        </ul>

        <p class="signature">Dra. {doctor.name}</p>
      </div>
    </div>
  </div>
</section>
