---
import { doctor } from '@/config/site';
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">

      <div>
        <a class="brand" href="#top" aria-label="Volver al inicio">
          <span class="brand__mark">{doctor.initials}</span>
          <span class="brand__name">
            {doctor.name}
            <small>{doctor.specialty}</small>
          </span>
        </a>
        <p style="color:#a59c8d;margin-top:18px;max-width:320px;font-size:15.5px;">
          Ortodoncia de precisión y estética. Acompañamos cada sonrisa con cercanía y tecnología.
        </p>
      </div>

      <div>
        <h4>Navegación</h4>
        <ul>
          <li><a href="#sobre">Sobre mí</a></li>
          <li><a href="#tratamientos">Tratamientos</a></li>
          <li><a href="#resultados">Resultados</a></li>
          <li><a href="#faq">Preguntas</a></li>
        </ul>
      </div>

      <div>
        <h4>Contacto</h4>
        <ul>
          <li><a href={`tel:+${doctor.whatsapp}`}>{doctor.phone}</a></li>
          <li><a href={`mailto:${doctor.email}`}>{doctor.email}</a></li>
          <li><a href="#contacto">Agendar cita →</a></li>
        </ul>
      </div>

    </div>

    <div class="footer__bottom">
      <span>© {new Date().getFullYear()} Dra. {doctor.name} · {doctor.specialty}. Todos los derechos reservados.</span>
      <span><a href="/aviso-de-privacidad">Aviso de privacidad</a> · <a href="/terminos">Términos</a></span>
    </div>
  </div>
</footer>

<!-- Floating WhatsApp -->
<a
  class="wa-float"
  href={`https://wa.me/${doctor.whatsapp}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contáctanos por WhatsApp"
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.42 5.82c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/>
  </svg>
</a>
