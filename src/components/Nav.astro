---
import { doctor } from '@/config/site';

// En la landing los enlaces son anclas (#contacto). En las páginas legales
// el mismo Nav se dibuja sobre una ruta sin secciones: ahí hay que volver al
// inicio antes de saltar, o el clic no hace nada.
interface Props {
  enInicio?: boolean;
}
const { enInicio = true } = Astro.props;
const enlace = (ancla: string) => `${enInicio ? '' : '/'}${ancla}`;
---

<header class="nav" id="nav">
  <div class="wrap nav__inner">
    <a class="brand" href={enlace('#top')} aria-label="Inicio">
      <span class="brand__mark">{doctor.initials}</span>
      <span class="brand__name">
        {doctor.name}
        <small>{doctor.specialty}</small>
      </span>
    </a>

    <p class="nav__meta">{doctor.specialty} · Guadalajara, Jalisco</p>

    <nav class="nav__links" id="navLinks" aria-label="Principal">
      <a href={enlace('#sobre')}>Sobre mí</a>
      <a href={enlace('#tratamientos')}>Tratamientos</a>
      <a href={enlace('#resultados')}>Resultados</a>
      <a href={enlace('#proceso')}>Proceso</a>
      <a href={enlace('#faq')}>Preguntas</a>
      {/* En móvil el botón de la barra no cabe junto al logo y la hamburguesa,
          así que la llamada a la acción vive dentro del menú desplegable. */}
      <a href={enlace('#contacto')} class="btn btn--primary nav__cta-movil">Agendar cita</a>
    </nav>

    <div class="nav__cta">
      <a href={enlace('#contacto')} class="btn btn--primary">Agendar cita</a>
      <button class="nav__burger" id="burger" aria-label="Menú" aria-expanded="false" aria-controls="navLinks">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const burger = document.getElementById('burger')!;
  const navLinks = document.getElementById('navLinks')!;

  function cerrarMenu(devolverFoco = false) {
    if (!navLinks.classList.contains('open')) return;
    navLinks.classList.remove('open');
    burger.setAttribute('aria-expanded', 'false');
    if (devolverFoco) burger.focus();
  }

  burger.addEventListener('click', () => {
    const abierto = navLinks.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(abierto));
  });

  // Al elegir un enlace, el menú se cierra
  navLinks.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') cerrarMenu();
  });

  // Escape cierra y devuelve el foco al botón
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarMenu(true);
  });

  // Un clic fuera del menú también lo cierra
  document.addEventListener('click', (e) => {
    const objetivo = e.target as Node;
    if (navLinks.contains(objetivo) || burger.contains(objetivo)) return;
    cerrarMenu();
  });
</script>
