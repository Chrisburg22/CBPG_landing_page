---
import { doctor } from '@/config/site';
---

<header class="nav" id="nav">
  <div class="wrap nav__inner">
    <a class="brand" href="#top" aria-label="Inicio">
      <span class="brand__mark">{doctor.initials}</span>
      <span class="brand__name">
        {doctor.name}
        <small>{doctor.specialty}</small>
      </span>
    </a>

    <nav class="nav__links" id="navLinks" aria-label="Principal">
      <a href="#sobre">Sobre mí</a>
      <a href="#tratamientos">Tratamientos</a>
      <a href="#resultados">Resultados</a>
      <a href="#proceso">Proceso</a>
      <a href="#faq">Preguntas</a>
      {/* En móvil el botón de la barra no cabe junto al logo y la hamburguesa,
          así que la llamada a la acción vive dentro del menú desplegable. */}
      <a href="#contacto" class="btn btn--primary nav__cta-movil">Agendar cita</a>
    </nav>

    <div class="nav__cta">
      <a href="#contacto" class="btn btn--primary">Agendar cita</a>
      <button class="nav__burger" id="burger" aria-label="Menú" aria-expanded="false" aria-controls="navLinks">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('nav')!;
  const burger = document.getElementById('burger')!;
  const navLinks = document.getElementById('navLinks')!;

  // Sombra al hacer scroll
  window.addEventListener('scroll', () => {
    nav.classList.toggle('is-stuck', window.scrollY > 12);
  }, { passive: true });

  function cerrarMenu(devolverFoco = false) {
    if (!navLinks.classList.contains('open')) return;
    navLinks.classList.remove('open');
    burger.setAttribute('aria-expanded', 'false');
    if (devolverFoco) burger.focus();
  }

  burger.addEventListener('click', () => {
    const abierto = navLinks.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(abierto));
  });

  // Al elegir un enlace, el menú se cierra
  navLinks.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') cerrarMenu();
  });

  // Escape cierra y devuelve el foco al botón
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarMenu(true);
  });

  // Un clic fuera del menú también lo cierra
  document.addEventListener('click', (e) => {
    const objetivo = e.target as Node;
    if (navLinks.contains(objetivo) || burger.contains(objetivo)) return;
    cerrarMenu();
  });
</script>
