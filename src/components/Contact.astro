---
import { doctor } from "@/config/site";
import BookingForm from "./BookingForm";
---

<section class="section" id="contacto">
  <div class="wrap">
    <div class="meta-row reveal">
      <span>(05) Agenda tu cita</span>
      <span>Respuesta en menos de 24 h</span>
    </div>

    <div class="contact__grid">
      <div class="reveal">
        <h2 class="section__titulo">Demos el primer paso hacia tu nueva sonrisa.</h2>
        <p class="section__intro">
          Reserva tu valoración inicial. Te responderemos para confirmar el día y
          la hora que mejor te convengan.
        </p>

        <ul class="info-list">
          <li>
            <b>Horario</b>
            <span>{doctor.schedule}</span>
          </li>
          <li>
            <b>Teléfono</b>
            <span><a href={`tel:+${doctor.whatsapp}`}>{doctor.phone}</a></span>
          </li>
          <li>
            <b>WhatsApp</b>
            <span>
              <a href={`https://wa.me/${doctor.whatsapp}`} target="_blank" rel="noopener noreferrer">
                Escríbenos directo →
              </a>
            </span>
          </li>
        </ul>
      </div>

      <!-- Form column (React island, loads when visible) -->
      <div class="reveal">
        <BookingForm client:visible whatsappNumber={doctor.whatsapp} />
      </div>
    </div>
  </div>
</section>
