---
import '@/styles/global.css';
import '@/styles/admin.css';
import NavPanel from '@/components/admin/NavPanel.astro';
import { contarNuevasParaNavegacion, type SeccionPanel } from '@/lib/panel';

interface Props {
  title: string;
  /** Sección activa en la navegación. Ausente en la pantalla de acceso. */
  seccion?: SeccionPanel | undefined;
  /** La pantalla de acceso no lleva navegación ni botón de salir. */
  conBarra?: boolean;
  /**
   * Prospectos sin atender, si la página ya lo calculó. Pasarlo evita repetir
   * la consulta; omitirlo hace que el layout la haga por su cuenta.
   */
  nuevas?: number | null | undefined;
}

const { title, seccion, conBarra = true, nuevas } = Astro.props;
const email = Astro.locals.user?.email ?? '';

const sinAtender =
  nuevas !== undefined
    ? nuevas
    : conBarra
      ? await contarNuevasParaNavegacion(Astro.locals.supabase)
      : null;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Panel</title>
    {/* El middleware manda además X-Robots-Tag, que cubre redirects y endpoints. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Sin fuentes de Google, sin JSON-LD, sin canonical: nada de esto tiene
        sentido en una pantalla privada, y quitarlo la hace cargar antes. */}
  </head>
  <body class="admin">
    {
      conBarra ? (
        <div class="marco">
          <NavPanel seccion={seccion ?? 'inicio'} nuevas={sinAtender} />

          <div class="marco__col">
            <header class="admin-barra">
              <div class="admin-barra__interior">
                <span class="admin-barra__marca">{title}</span>
                <div class="admin-barra__derecha">
                  {email && <span class="admin-barra__email">{email}</span>}
                  <form method="post" action="/admin/auth/salir">
                    <button class="btn btn--ghost btn--chico" type="submit">
                      Salir
                    </button>
                  </form>
                </div>
              </div>
            </header>

            <main class="admin-main" id="contenido">
              <slot />
            </main>
          </div>
        </div>
      ) : (
        <main class="wrap admin-main" id="contenido">
          <slot />
        </main>
      )
    }
  </body>
</html>
