---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Icono from '@/components/admin/Icono.astro';
import { aDuracion, crear, esTipoCita, listarDelDia, obtener as obtenerCita } from '@/lib/citas';
import { obtener as obtenerSolicitud, cambiarEstado } from '@/lib/solicitudes';
import { obtener as obtenerPaciente } from '@/lib/pacientes';
import { registrar } from '@/lib/seguimiento';
import { sincronizacionActiva } from '@/lib/google/almacen';
import { sincronizar } from '@/lib/google/sincronizar';
import { APERTURA, CIERRE } from '@/lib/horario';
import { iniciales } from '@/lib/formato';
import { aCampoLocal, deMexicoAIso, diaEnMexico, diaLargo, partesEnMexico } from '@/lib/tiempo';
import { ETIQUETA_ESTADO, ETIQUETA_TIPO_CITA, TIPOS_CITA } from '@/lib/supabase/tipos';

export const prerender = false;

const supabase = Astro.locals.supabase;
const esDoctora = Astro.locals.rol === 'doctora';

const params = Astro.url.searchParams;
const solicitudId = params.get('solicitud');
// Solo la doctora puede leer `pacientes`: para recepción este parámetro no
// existe, y si lo escribiera a mano la consulta le devolvería `null` por RLS.
const pacienteId = esDoctora ? params.get('paciente') : null;

/** Datos de contacto con los que se precarga el formulario. */
let nombreSugerido = '';
let telefonoSugerido = '';
/** De quién es la cita, para la tarjeta de arriba. */
let deQuien: { tipo: 'prospecto' | 'paciente'; nombre: string; detalle: string } | null = null;

if (solicitudId) {
  const solicitud = await obtenerSolicitud(supabase, solicitudId).catch(() => null);
  if (solicitud) {
    nombreSugerido = solicitud.nombre;
    telefonoSugerido = solicitud.telefono;
    deQuien = {
      tipo: 'prospecto',
      nombre: solicitud.nombre,
      detalle: `${solicitud.tratamiento} · ${ETIQUETA_ESTADO[solicitud.estado]}`,
    };
  }
} else if (pacienteId) {
  const paciente = await obtenerPaciente(supabase, pacienteId).catch(() => null);
  if (paciente) {
    nombreSugerido = paciente.nombre;
    telefonoSugerido = paciente.telefono;
    deQuien = { tipo: 'paciente', nombre: paciente.nombre, detalle: paciente.tratamiento };
  }
}

let error: string | null = null;
/** Lo tecleado, para no vaciar el formulario cuando algo no cuadra. */
let enviado: { cuando: string; duracion: string; tipo: string; nota: string } | null = null;

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();

  const nombre = String(datos.get('nombre') ?? '').trim();
  const telefono = String(datos.get('telefono') ?? '').trim();
  const cuando = String(datos.get('inicia_en') ?? '');
  const tipo = String(datos.get('tipo') ?? '');
  const duracion = aDuracion(String(datos.get('duracion_min') ?? ''));
  const nota = String(datos.get('nota') ?? '').slice(0, 1000);

  // La hora llega como hora de pared ('2026-09-11T16:30'). Convertirla aquí y
  // no en el navegador es lo que evita que la cita se mueva seis horas: este
  // código corre en Vercel, cuyo reloj está en UTC.
  const iniciaEn = deMexicoAIso(cuando);

  nombreSugerido = nombre;
  telefonoSugerido = telefono;
  enviado = { cuando, duracion: String(datos.get('duracion_min') ?? ''), tipo, nota };

  if (!nombre) error = 'Falta el nombre de quien viene.';
  else if (!iniciaEn) error = 'Falta la fecha y la hora.';
  else if (!duracion) error = 'La duración tiene que ir entre 5 y 480 minutos.';
  else if (!esTipoCita(tipo)) error = 'Ese tipo de cita no existe.';

  if (!error && iniciaEn && duracion && esTipoCita(tipo)) {
    try {
      const activa = await sincronizacionActiva();
      const id = await crear(
        supabase,
        {
          solicitud_id: solicitudId ?? null,
          paciente_id: pacienteId ?? null,
          nombre_contacto: nombre.slice(0, 120),
          telefono_contacto: telefono.slice(0, 30),
          inicia_en: iniciaEn,
          duracion_min: duracion,
          tipo,
          nota,
        },
        activa
      );

      if (solicitudId) {
        // El prospecto pasa a «agendada» solo si seguía por delante de ese
        // punto: un descartado que vuelve no debe reaparecer como nuevo, y uno
        // ya terminado es paciente y su estado no se toca.
        const solicitud = await obtenerSolicitud(supabase, solicitudId).catch(() => null);
        if (solicitud && (solicitud.estado === 'nueva' || solicitud.estado === 'contactada')) {
          await cambiarEstado(supabase, solicitudId, 'agendada');
        }
        await registrar(supabase, solicitudId, 'cita_creada', { citaId: id });
      }

      // La cita YA está guardada. Google es un espejo: si falla, la cita queda
      // marcada como pendiente y se reintenta desde la agenda.
      if (activa) {
        const cita = await obtenerCita(supabase, id);
        if (cita) await sincronizar(supabase, cita);
      }

      return Astro.redirect(`/admin/agenda?dia=${diaEnMexico(iniciaEn)}&cita=${id}&guardado=1`, 303);
    } catch (e) {
      console.error('[admin] no se pudo crear la cita:', e instanceof Error ? e.message : 'desconocido');
      error = 'No se pudo guardar la cita. Inténtalo otra vez.';
    }
  }
}

/** Valor inicial del campo de fecha: el día que se estaba mirando, a las 10:00. */
const diaParam = params.get('dia');
const diaInicial =
  diaParam && /^\d{4}-\d{2}-\d{2}$/.test(diaParam) ? diaParam : diaEnMexico(new Date());
const cuandoInicial =
  enviado?.cuando ||
  aCampoLocal(deMexicoAIso(`${diaInicial}T10:00`) ?? new Date().toISOString());
const duracionInicial = enviado?.duracion || '30';
const tipoInicial = enviado?.tipo || (solicitudId ? 'valoracion' : 'control');
const notaInicial = enviado?.nota ?? '';

/**
 * Lo que ya está ocupado ese día, para dibujar la franja. Se calcula aquí para
 * el día inicial —así se ve sin JavaScript— y el script de abajo la vuelve a
 * pedir si se cambia la fecha.
 */
const diaDeLaFranja = cuandoInicial.slice(0, 10);
const ocupado = await listarDelDia(supabase, diaDeLaFranja)
  .then((lista) =>
    lista
      .filter((c) => c.estado !== 'cancelada')
      .map((c) => {
        const { hora, minuto } = partesEnMexico(new Date(c.inicia_en));
        const inicio = hora * 60 + minuto;
        return { inicio, fin: inicio + c.duracion_min };
      })
  )
  .catch(() => []);

const JORNADA = (CIERRE - APERTURA) * 60;
const pct = (minutos: number) =>
  Math.max(0, Math.min(100, ((minutos - APERTURA * 60) / JORNADA) * 100));
const activaGoogle = await sincronizacionActiva().catch(() => false);
---

<AdminLayout title="Nueva cita" seccion="agenda">
  <div class="admin-head">
    <div>
      <h1>Nueva cita</h1>
      <p>Se guarda en el panel aunque Google no conteste; la copia al calendario va después.</p>
    </div>
    <a class="btn btn--ghost btn--chico" href="/admin/agenda">
      <Icono nombre="izquierda" tam={16} /> Agenda
    </a>
  </div>

  {
    error && (
      <p class="aviso aviso--error" role="alert">
        <Icono nombre="alerta" />
        <span class="aviso__texto">{error}</span>
      </p>
    )
  }

  <form method="post" class="agenda-layout">
    <div class="columna">
      <section class="panel" aria-labelledby="titulo-quien">
        <h2 class="panel__titulo" id="titulo-quien">¿Quién viene?</h2>
        {
          deQuien ? (
            <div class="cita-destacada panel--tinta" style="border: 1px solid var(--teal-200); margin-bottom: 18px">
              <span class={`avatar ${deQuien.tipo === 'paciente' ? 'avatar--teal' : ''}`} style="width: 44px; height: 44px; font-size: 18px">
                {iniciales(deQuien.nombre)}
              </span>
              <span style="flex: 1; min-width: 0">
                <span class="eyebrow-panel">{deQuien.tipo === 'paciente' ? 'Paciente' : 'Prospecto'}</span>
                <b style="display: block">{deQuien.nombre}</b>
                <span class="tabla__sec">{deQuien.detalle}</span>
              </span>
            </div>
          ) : (
            <p class="aviso aviso--info" style="margin-bottom: 18px">
              <Icono nombre="nota" />
              <span class="aviso__texto">
                Cita sin ficha. Para ligarla a alguien, créala desde su{' '}
                <a href="/admin/prospectos">prospecto</a>
                {esDoctora && (
                  <>
                    {' '}o su <a href="/admin/pacientes">ficha de paciente</a>
                  </>
                )}
                .
              </span>
            </p>
          )
        }
        <div class="campos-2">
          <div class="field">
            <label for="nombre">Nombre de quien viene</label>
            <input id="nombre" name="nombre" required maxlength="120" autocomplete="off" value={nombreSugerido} />
          </div>
          <div class="field">
            <label for="telefono">Teléfono</label>
            <input id="telefono" name="telefono" type="tel" maxlength="30" autocomplete="off" value={telefonoSugerido} />
          </div>
        </div>
        <p class="field__ayuda" style="margin-top: -6px">
          Nombre y teléfono se copian a la cita: recepción los ve sin abrir la ficha.
        </p>
      </section>

      <section class="panel" aria-labelledby="titulo-cuando">
        <h2 class="panel__titulo" id="titulo-cuando">¿Cuándo?</h2>
        <div class="campos">
          <div class="field">
            <label for="inicia_en">Fecha y hora</label>
            <input id="inicia_en" name="inicia_en" type="datetime-local" required value={cuandoInicial} />
            <span class="field__ayuda">Hora de Ciudad de México.</span>
          </div>
          <div class="field">
            <label for="tipo">Tipo</label>
            <select id="tipo" name="tipo">
              {TIPOS_CITA.map((valor) => (
                <option value={valor} selected={valor === tipoInicial}>
                  {ETIQUETA_TIPO_CITA[valor]}
                </option>
              ))}
            </select>
          </div>
          <div class="field">
            <label for="duracion_min">Duración (minutos)</label>
            <input id="duracion_min" name="duracion_min" type="number" min="5" max="480" step="5" required value={duracionInicial} />
            {/* Atajos para las duraciones de siempre. Sin JavaScript no hacen
                nada y el campo de arriba sigue funcionando igual. */}
            <div class="duraciones" data-duraciones hidden>
              {[15, 30, 45, 60, 90].map((m) => (
                <button type="button" class="fchip" data-min={m} aria-pressed={Number(duracionInicial) === m ? 'true' : 'false'}>
                  {m} min
                </button>
              ))}
            </div>
          </div>
        </div>

        <div style="margin-top: 20px">
          <div class="panel__cabecera" style="margin-bottom: 8px">
            <span style="font-size: 14px; font-weight: 600" data-ocupacion-titulo>
              Ocupación del {diaLargo(diaDeLaFranja, false)}
            </span>
            <span class="tabla__sec" style="margin: 0">{APERTURA}:00 – {CIERRE}:00</span>
          </div>
          <div class="ocupacion" data-ocupacion aria-hidden="true">
            {
              ocupado.map((o) => (
                <span class="ocupacion__ocupado" data-ocupado style={`left: ${pct(o.inicio)}%; width: ${pct(o.fin) - pct(o.inicio)}%`} />
              ))
            }
            <span class="ocupacion__nueva" data-nueva />
            {
              [9, 11, 13, 15, 17].map((h) => (
                <span class="ocupacion__marca" style={`left: calc(${pct(h * 60)}% + 4px)`}>{h}</span>
              ))
            }
          </div>
          <p class="field__ayuda" data-ocupacion-texto aria-live="polite">
            Gris: ya ocupado. {ocupado.length === 0 ? 'Ese día no tiene citas.' : ''}
          </p>
        </div>

        <div class="field" style="margin: 18px 0 0">
          <label for="nota">Nota para la agenda</label>
          <textarea id="nota" name="nota" rows="3" maxlength="1000">{notaInicial}</textarea>
          <span class="field__ayuda">Solo lo necesario para recibir a la persona. Nada de historia clínica.</span>
        </div>
      </section>
    </div>

    <aside class="agenda-lateral">
      <section class="panel panel--tinta">
        <span class="eyebrow-panel" style="color: var(--teal-600)">Al guardar</span>
        <ul class="linea" style="margin-top: 8px">
          {
            solicitudId && (
              <li class="linea__item" style="grid-template-columns: 24px 1fr">
                <Icono nombre="hecho" tam={16} />
                <span>El prospecto pasa a <span class="chip chip--agendada">Agendada</span></span>
              </li>
            )
          }
          <li class="linea__item" style="grid-template-columns: 24px 1fr">
            <Icono nombre="sincronizar" tam={16} />
            <span>{activaGoogle ? 'Se copia a Google Calendar' : 'Queda en el panel (sin Google conectado)'}</span>
          </li>
          {
            (solicitudId || pacienteId) && (
              <li class="linea__item" style="grid-template-columns: 24px 1fr">
                <Icono nombre="nota" tam={16} />
                <span>Aparece en su ficha</span>
              </li>
            )
          }
        </ul>
        <button class="btn btn--primary btn--block" type="submit" style="margin-top: 18px">Guardar cita</button>
        <a class="btn btn--ghost btn--chico btn--block" href="/admin/agenda" style="margin-top: 8px">Cancelar</a>
      </section>
    </aside>
  </form>

  <script is:inline define:vars={{ apertura: APERTURA, cierre: CIERRE }}>
    (() => {
      const campoCuando = document.getElementById('inicia_en');
      const campoDuracion = document.getElementById('duracion_min');
      const atajos = document.querySelector('[data-duraciones]');
      const franja = document.querySelector('[data-ocupacion]');
      const nueva = franja?.querySelector('[data-nueva]');
      const texto = document.querySelector('[data-ocupacion-texto]');
      const titulo = document.querySelector('[data-ocupacion-titulo]');
      if (!campoCuando || !campoDuracion || !franja || !nueva) return;

      const jornada = (cierre - apertura) * 60;
      const pct = (m) => Math.max(0, Math.min(100, ((m - apertura * 60) / jornada) * 100));
      let ocupado = [...franja.querySelectorAll('[data-ocupado]')].map((el) => {
        const left = parseFloat(el.style.left);
        const width = parseFloat(el.style.width);
        return { inicio: apertura * 60 + (left / 100) * jornada, fin: apertura * 60 + ((left + width) / 100) * jornada };
      });
      let diaActual = (campoCuando.value || '').slice(0, 10);

      function pintar() {
        const valor = campoCuando.value || '';
        const [h, m] = (valor.slice(11, 16) || '').split(':').map(Number);
        const dur = Number(campoDuracion.value);
        if (Number.isNaN(h) || Number.isNaN(m) || !dur) {
          nueva.hidden = true;
          return;
        }
        const inicio = h * 60 + m;
        const fin = inicio + dur;
        nueva.hidden = false;
        nueva.style.left = `${pct(inicio)}%`;
        nueva.style.width = `${Math.max(0.6, pct(fin) - pct(inicio))}%`;
        const choca = ocupado.some((o) => inicio < o.fin && fin > o.inicio);
        const fueraHorario = inicio < apertura * 60 || fin > cierre * 60;
        nueva.classList.toggle('ocupacion__nueva--choca', choca);
        if (texto) {
          texto.textContent = choca
            ? 'Rojo: se cruza con otra cita. Puedes guardarla igual si es a propósito.'
            : fueraHorario
              ? 'Queda fuera del horario del consultorio.'
              : 'Gris: ya ocupado. Arcilla: la cita que estás creando. No choca con nada.';
        }
      }

      async function recargar() {
        const dia = (campoCuando.value || '').slice(0, 10);
        if (!/^\d{4}-\d{2}-\d{2}$/.test(dia) || dia === diaActual) return pintar();
        diaActual = dia;
        try {
          const r = await fetch(`/admin/agenda/ocupacion?dia=${dia}`, { headers: { accept: 'application/json' } });
          if (!r.ok) throw new Error(String(r.status));
          const datos = await r.json();
          ocupado = datos.ocupado ?? [];
          for (const el of franja.querySelectorAll('[data-ocupado]')) el.remove();
          for (const o of ocupado) {
            const el = document.createElement('span');
            el.className = 'ocupacion__ocupado';
            el.dataset.ocupado = '';
            el.style.left = `${pct(o.inicio)}%`;
            el.style.width = `${pct(o.fin) - pct(o.inicio)}%`;
            franja.prepend(el);
          }
          if (titulo) {
            const fecha = new Date(`${dia}T12:00:00`);
            titulo.textContent = `Ocupación del ${fecha.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' })}`;
          }
        } catch {
          ocupado = [];
          if (texto) texto.textContent = 'No se pudo consultar la ocupación de ese día.';
        }
        pintar();
      }

      if (atajos) {
        atajos.hidden = false;
        atajos.addEventListener('click', (e) => {
          const boton = e.target.closest('[data-min]');
          if (!boton) return;
          campoDuracion.value = boton.dataset.min;
          for (const b of atajos.querySelectorAll('[data-min]')) b.setAttribute('aria-pressed', String(b === boton));
          pintar();
        });
        campoDuracion.addEventListener('input', () => {
          for (const b of atajos.querySelectorAll('[data-min]')) b.setAttribute('aria-pressed', String(b.dataset.min === campoDuracion.value));
          pintar();
        });
      }
      campoCuando.addEventListener('change', recargar);
      campoCuando.addEventListener('input', pintar);
      pintar();
    })();
  </script>
</AdminLayout>
