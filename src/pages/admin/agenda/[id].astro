---
import AdminLayout from '@/layouts/AdminLayout.astro';
import {
  actualizar,
  aDuracion,
  cambiarEstado,
  esEstadoCita,
  esTipoCita,
  obtener,
} from '@/lib/citas';
import { registrar } from '@/lib/seguimiento';
import { porSolicitud } from '@/lib/pacientes';
import { sincronizacionActiva } from '@/lib/google/almacen';
import { sincronizar } from '@/lib/google/sincronizar';
import { aTelefono, aWhatsappCita } from '@/lib/contacto-directo';
import { aCampoLocal, deMexicoAIso, fechaHora } from '@/lib/tiempo';
import {
  ESTADOS_CITA,
  ETIQUETA_ESTADO_CITA,
  ETIQUETA_TIPO_CITA,
  TIPOS_CITA,
  type Cita,
} from '@/lib/supabase/tipos';

export const prerender = false;

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/agenda', 302);

const supabase = Astro.locals.supabase;
const esDoctora = Astro.locals.rol === 'doctora';

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = String(datos.get('accion') ?? '');

  try {
    const activa = await sincronizacionActiva();
    const antes = await obtener(supabase, id);
    if (!antes) return new Response('No encontrada', { status: 404 });

    if (accion === 'reprogramar') {
      const iniciaEn = deMexicoAIso(String(datos.get('inicia_en') ?? ''));
      const duracion = aDuracion(String(datos.get('duracion_min') ?? ''));
      const tipo = String(datos.get('tipo') ?? '');
      if (!iniciaEn || !duracion || !esTipoCita(tipo)) {
        return Astro.redirect(`${Astro.url.pathname}?error=datos`, 303);
      }
      await actualizar(
        supabase,
        id,
        {
          inicia_en: iniciaEn,
          duracion_min: duracion,
          tipo,
          nombre_contacto: String(datos.get('nombre') ?? antes.nombre_contacto).slice(0, 120),
          telefono_contacto: String(datos.get('telefono') ?? '').slice(0, 30),
          nota: String(datos.get('nota') ?? '').slice(0, 1000),
        },
        activa
      );
      if (antes.solicitud_id && iniciaEn !== antes.inicia_en) {
        await registrar(supabase, antes.solicitud_id, 'cita_reprogramada', { citaId: id });
      }
    } else if (accion === 'estado') {
      const nuevo = String(datos.get('estado') ?? '');
      if (!esEstadoCita(nuevo)) return Astro.redirect(`${Astro.url.pathname}?error=datos`, 303);
      await cambiarEstado(supabase, id, nuevo, activa);
      if (antes.solicitud_id && nuevo === 'cancelada') {
        await registrar(supabase, antes.solicitud_id, 'cita_cancelada', { citaId: id });
      }
    }

    // Siempre después de escribir en la base, nunca antes: la cita ya está
    // guardada pase lo que pase con Google.
    if (activa) {
      const despues = await obtener(supabase, id);
      if (despues) await sincronizar(supabase, despues);
    }

    return Astro.redirect(`${Astro.url.pathname}?guardado=1`, 303);
  } catch (e) {
    console.error('[admin] no se pudo guardar la cita:', e instanceof Error ? e.message : 'desconocido');
    return Astro.redirect(`${Astro.url.pathname}?error=guardar`, 303);
  }
}

let cita: Cita | null = null;
/** El paciente que salió del prospecto de esta cita, si ya se convirtió. */
let yaPaciente: { id: string; nombre: string } | null = null;
let fallo: string | null = null;

try {
  cita = await obtener(supabase, id);
  // Solo la doctora puede leer `pacientes`; para recepción esto no se pregunta.
  if (cita?.solicitud_id && esDoctora) {
    yaPaciente = await porSolicitud(supabase, cita.solicitud_id);
  }
} catch (e) {
  console.error('[admin] no se pudo cargar la cita:', e instanceof Error ? e.message : 'desconocido');
  fallo = 'No pudimos cargar la cita. Vuelve a intentarlo en un momento.';
}

if (!cita && !fallo) return new Response('No encontrada', { status: 404 });

const params = Astro.url.searchParams;
const guardado = params.get('guardado') === '1';
const error = params.get('error');

/**
 * La conversión se OFRECE, no se hace sola. Que alguien viniera a valoración no
 * significa que aceptara el tratamiento, y un paciente creado por error arrastra
 * plan, cuotas y una ficha que ya no se puede borrar.
 */
const ofrecerConversion =
  !!cita && cita.estado === 'atendida' && !!cita.solicitud_id && esDoctora && !yaPaciente;
---

<AdminLayout title={cita?.nombre_contacto ?? 'Cita'} seccion="agenda">
  <div class="admin-head">
    <div>
      <h1>{cita?.nombre_contacto ?? 'Cita'}</h1>
      {cita && <p>{ETIQUETA_TIPO_CITA[cita.tipo]} · {fechaHora(cita.inicia_en)}</p>}
    </div>
    <a class="btn btn--ghost btn--chico" href="/admin/agenda">← Agenda</a>
  </div>

  {fallo && <p class="aviso aviso--error">{fallo}</p>}
  {guardado && <p class="aviso aviso--ok">Guardado.</p>}
  {error === 'guardar' && <p class="aviso aviso--error">No se pudo guardar. Inténtalo otra vez.</p>}
  {error === 'datos' && <p class="aviso aviso--error">Revisa la fecha, la duración y el tipo.</p>}

  {
    cita && (cita.google_sync === 'error' || cita.google_sync === 'pendiente') && (
      <p class="aviso aviso--aviso">
        Esta cita está guardada, pero todavía no se refleja en Google Calendar.
        {cita.google_error && <span class="aviso__detalle">{cita.google_error}</span>}
        <a href="/admin/agenda">Reintentar desde la agenda</a>
      </p>
    )
  }

  {
    cita && (
      <div class="detalle-grid">
        <div>
          <form class="panel" method="post">
            <h2 class="panel__titulo">Cuándo</h2>
            <input type="hidden" name="accion" value="reprogramar" />

            <div class="campos-2">
              <div class="field">
                <label for="inicia_en">Fecha y hora</label>
                <input
                  id="inicia_en"
                  name="inicia_en"
                  type="datetime-local"
                  required
                  value={aCampoLocal(cita.inicia_en)}
                />
                <p class="field__ayuda">Hora de Ciudad de México.</p>
              </div>
              <div class="field">
                <label for="duracion_min">Duración (minutos)</label>
                <input
                  id="duracion_min"
                  name="duracion_min"
                  type="number"
                  min="5"
                  max="480"
                  step="5"
                  required
                  value={cita.duracion_min}
                />
              </div>
            </div>

            <div class="campos-2">
              <div class="field">
                <label for="nombre">Nombre</label>
                <input id="nombre" name="nombre" maxlength="120" value={cita.nombre_contacto} />
              </div>
              <div class="field">
                <label for="telefono">Teléfono</label>
                <input
                  id="telefono"
                  name="telefono"
                  maxlength="30"
                  value={cita.telefono_contacto}
                />
              </div>
            </div>

            <div class="field">
              <label for="tipo">Tipo</label>
              <select id="tipo" name="tipo">
                {TIPOS_CITA.map((valor) => (
                  <option value={valor} selected={valor === cita?.tipo}>
                    {ETIQUETA_TIPO_CITA[valor]}
                  </option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="nota">Nota para la agenda</label>
              {/* Sin saltos de línea alrededor: dentro de un textarea, el
                  espacio del marcado es contenido. */}
              <textarea id="nota" name="nota" rows="3" maxlength="1000">{cita.nota}</textarea>
            </div>

            <button class="btn btn--primary btn--block btn--chico" type="submit">
              Guardar cambios
            </button>
          </form>

          {cita.telefono_contacto && (
            <div class="panel">
              <h2 class="panel__titulo">Contacto</h2>
              <div class="acciones">
                <a
                  class="btn btn--primary btn--chico"
                  href={aWhatsappCita(
                    cita.telefono_contacto,
                    cita.nombre_contacto,
                    fechaHora(cita.inicia_en)
                  )}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Confirmar por WhatsApp
                </a>
                <a class="btn btn--ghost btn--chico" href={aTelefono(cita.telefono_contacto)}>
                  Llamar
                </a>
              </div>
            </div>
          )}
        </div>

        <div>
          <form class="panel" method="post">
            <h2 class="panel__titulo">Asistencia</h2>
            <input type="hidden" name="accion" value="estado" />
            <div class="field">
              <label for="estado">Cómo quedó esta cita</label>
              <select id="estado" name="estado">
                {ESTADOS_CITA.map((valor) => (
                  <option value={valor} selected={valor === cita?.estado}>
                    {ETIQUETA_ESTADO_CITA[valor]}
                  </option>
                ))}
              </select>
            </div>
            <button class="btn btn--primary btn--block btn--chico" type="submit">
              Guardar asistencia
            </button>
          </form>

          {ofrecerConversion && (
            <div class="panel panel--destacado">
              <h2 class="panel__titulo">¿Aceptó el tratamiento?</h2>
              <p class="panel__texto">
                La cita quedó como atendida. Si acepta empezar, conviértelo en paciente: se
                crea su ficha y el prospecto queda como terminado.
              </p>
              <a
                class="btn btn--primary btn--block btn--chico"
                href={`/admin/prospectos/${cita.solicitud_id}/convertir`}
              >
                Convertir en paciente
              </a>
            </div>
          )}

          <div class="panel">
            <h2 class="panel__titulo">De quién es</h2>
            {cita.solicitud_id ? (
              <p class="panel__texto">
                <a href={`/admin/prospectos/${cita.solicitud_id}`}>Ver el prospecto</a>
              </p>
            ) : cita.paciente_id ? (
              esDoctora ? (
                <p class="panel__texto">
                  <a href={`/admin/pacientes/${cita.paciente_id}`}>Ver la ficha del paciente</a>
                </p>
              ) : (
                <p class="panel__texto">Cita de un paciente en tratamiento.</p>
              )
            ) : (
              <p class="panel__texto">Cita suelta: no está ligada a ningún prospecto ni ficha.</p>
            )}
            {yaPaciente && (
              <p class="panel__texto">
                Ya es paciente: <a href={`/admin/pacientes/${yaPaciente.id}`}>{yaPaciente.nombre}</a>
              </p>
            )}
          </div>
        </div>
      </div>
    )
  }
</AdminLayout>
