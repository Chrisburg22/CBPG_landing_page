---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Icono from '@/components/admin/Icono.astro';
import {
  cambiarEstado,
  esEstadoCita,
  listarEntre,
  obtener as obtenerCita,
  pendientesDeSincronizar,
} from '@/lib/citas';
import { sincronizacionActiva } from '@/lib/google/almacen';
import { reintentar, sincronizar } from '@/lib/google/sincronizar';
import { porSolicitud as pacienteDeSolicitud } from '@/lib/pacientes';
import { registrar } from '@/lib/seguimiento';
import { aTelefono, aWhatsappCita } from '@/lib/contacto-directo';
import {
  cerradoDesde,
  colocar,
  HORAS_REJILLA,
  APERTURA,
  CIERRE,
  posicionAhora,
  type Bloque,
} from '@/lib/horario';
import {
  diaCortoConNumero,
  diaEnMexico,
  diaLargo,
  fechaHora,
  hora,
  lunesDeLaSemana,
  sumarDias,
} from '@/lib/tiempo';
import {
  ESTADOS_CITA,
  ETIQUETA_ESTADO_CITA,
  ETIQUETA_TIPO_CITA,
  type Cita,
  type EstadoCita,
} from '@/lib/supabase/tipos';

export const prerender = false;

const supabase = Astro.locals.supabase;
const esDoctora = Astro.locals.rol === 'doctora';
const hoy = diaEnMexico(new Date());

// POST-Redirect-GET, como en el resto del panel. Astro valida Origin por su
// cuenta, y por eso esto son formularios nativos y no fetch con JSON.
if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = String(datos.get('accion') ?? '');
  // Conservar la vista: perder el día que estabas mirando al marcar una cita
  // como atendida sería desconcertante.
  const volver = new URL(Astro.url);
  volver.searchParams.delete('error');
  volver.searchParams.delete('guardado');

  try {
    if (accion === 'estado') {
      const id = String(datos.get('id') ?? '');
      const nuevo = String(datos.get('estado') ?? '');
      if (id && esEstadoCita(nuevo)) {
        const activa = await sincronizacionActiva();
        const antes = await obtenerCita(supabase, id);
        await cambiarEstado(supabase, id, nuevo, activa);
        if (antes?.solicitud_id && nuevo === 'cancelada' && antes.estado !== 'cancelada') {
          await registrar(supabase, antes.solicitud_id, 'cita_cancelada', { citaId: id });
        }
        // Cancelar borra el evento en Google. Se intenta aquí mismo y, si
        // falla, la cita queda marcada y el botón de reintentar la recoge:
        // nunca se pierde la cancelación por un fallo de Google.
        if (activa && nuevo === 'cancelada') {
          const cita = await obtenerCita(supabase, id);
          if (cita) await sincronizar(supabase, cita);
        }
        volver.searchParams.set('guardado', '1');
      }
    } else if (accion === 'sincronizar') {
      const pendientes = await pendientesDeSincronizar(supabase);
      await reintentar(supabase, pendientes);
    }
  } catch (e) {
    console.error('[admin] agenda:', e instanceof Error ? e.message : 'desconocido');
    volver.searchParams.set('error', '1');
  }
  return Astro.redirect(`${volver.pathname}${volver.search}`, 303);
}

const params = Astro.url.searchParams;
const vista = params.get('vista') === 'semana' ? 'semana' : 'dia';
const diaParam = params.get('dia');
const dia = diaParam && /^\d{4}-\d{2}-\d{2}$/.test(diaParam) ? diaParam : hoy;
const estadoParam = params.get('estado');
const estado = esEstadoCita(estadoParam) ? estadoParam : undefined;
const soloMias = params.get('mias') === '1';
const citaParam = params.get('cita');
const guardado = params.get('guardado') === '1';
const errorGuardar = params.get('error') === '1';

const lunes = lunesDeLaSemana(dia);
const diasSemana = Array.from({ length: 6 }, (_, i) => sumarDias(lunes, i));
// En vista semanal el rango va de lunes a domingo —el domingo no se dibuja,
// pero sus citas tienen que aparecer en «fuera de horario»—; en diaria, un día.
const primerDia = vista === 'semana' ? lunes : dia;
const ultimoDia = vista === 'semana' ? sumarDias(lunes, 6) : dia;
const salto = vista === 'semana' ? 7 : 1;

let todas: Cita[] = [];
let semanaEntera: Cita[] = [];
let sinSincronizar = 0;
let integracionActiva = false;
let elegida: Cita | null = null;
let yaPaciente: { id: string; nombre: string } | null = null;
let fallo: string | null = null;

try {
  const [lista, semana, pendientes, activa, cita] = await Promise.all([
    listarEntre(supabase, primerDia, ultimoDia),
    // Para el selector de días del teléfono: cuántas citas tiene cada día.
    vista === 'semana' ? Promise.resolve(null) : listarEntre(supabase, lunes, sumarDias(lunes, 5)),
    pendientesDeSincronizar(supabase, 100),
    sincronizacionActiva(),
    citaParam ? obtenerCita(supabase, citaParam) : Promise.resolve(null),
  ]);
  todas = lista;
  semanaEntera = semana ?? lista;
  sinSincronizar = pendientes.length;
  integracionActiva = activa;
  elegida = cita;
  // Solo la doctora puede leer `pacientes`; para recepción esto no se pregunta.
  if (elegida?.solicitud_id && esDoctora) {
    yaPaciente = await pacienteDeSolicitud(supabase, elegida.solicitud_id);
  }
} catch (e) {
  console.error('[admin] no se pudo cargar la agenda:', e instanceof Error ? e.message : 'desconocido');
  fallo = 'No pudimos cargar la agenda. Vuelve a intentarlo en un momento.';
}

// Los filtros se aplican aquí y no en la consulta: los contadores de cada chip
// tienen que salir de todas las citas del rango, no solo de las filtradas.
const usuario = Astro.locals.user?.id;
const citas = todas.filter(
  (c) => (!estado || c.estado === estado) && (!soloMias || c.responsable === usuario)
);
const cuenta = Object.fromEntries(
  ESTADOS_CITA.map((e) => [e, todas.filter((c) => c.estado === e).length])
) as Record<EstadoCita, number>;

/** Mantiene el resto de filtros al moverse de día o cambiar de vista. */
function enlace(cambios: Record<string, string | undefined>): string {
  const nuevos = new URLSearchParams(params);
  nuevos.delete('guardado');
  nuevos.delete('error');
  for (const [clave, valor] of Object.entries(cambios)) {
    if (valor === undefined) nuevos.delete(clave);
    else nuevos.set(clave, valor);
  }
  const cadena = nuevos.toString();
  return `/admin/agenda${cadena ? `?${cadena}` : ''}`;
}

/** Las citas colocadas en la rejilla de cada día visible. */
const columnas = (vista === 'semana' ? diasSemana : [dia]).map((d) => ({
  dia: d,
  ...colocar(citas.filter((c) => diaEnMexico(c.inicia_en) === d), d),
  cerrado: cerradoDesde(d),
}));
const fuera: Cita[] = [
  ...columnas.flatMap((c) => c.fuera),
  // El domingo no tiene columna: sus citas van directas a la lista.
  ...(vista === 'semana' ? citas.filter((c) => diaEnMexico(c.inicia_en) === sumarDias(lunes, 6)) : []),
];
const ahora = posicionAhora();

const atendidas = todas.filter((c) => c.estado === 'atendida').length;
const noAsistio = todas.filter((c) => c.estado === 'no_asistio').length;
const vivas = todas.filter((c) => c.estado !== 'cancelada');
const proxima = vivas.find((c) => new Date(c.inicia_en).getTime() > Date.now()) ?? null;

const titulo = vista === 'semana' ? `Semana del ${diaLargo(lunes, false)}` : diaLargo(dia);

/**
 * La conversión se OFRECE, no se hace sola. Que alguien viniera a valoración no
 * significa que aceptara el tratamiento, y un paciente creado por error arrastra
 * plan, cuotas y una ficha que ya no se puede borrar.
 */
const ofrecerConversion =
  !!elegida && elegida.estado === 'atendida' && !!elegida.solicitud_id && esDoctora && !yaPaciente;

const claseBloque = (b: Bloque) =>
  [
    'bloque',
    b.cita.estado === 'cancelada'
      ? 'bloque--cancelada'
      : b.cita.estado === 'no_asistio'
        ? 'bloque--no_asistio'
        : `bloque--${b.cita.tipo}`,
    b.corto ? 'bloque--corto' : '',
    b.cita.id === elegida?.id ? 'bloque--elegido' : '',
  ]
    .filter(Boolean)
    .join(' ');
---

<AdminLayout title="Agenda" seccion="agenda">
  <div class="admin-head">
    <div>
      <h1>{titulo}</h1>
      <p>
        {todas.length} {todas.length === 1 ? 'cita' : 'citas'}
        {atendidas > 0 && ` · ${atendidas} ${atendidas === 1 ? 'atendida' : 'atendidas'}`}
        {noAsistio > 0 && ` · ${noAsistio} no ${noAsistio === 1 ? 'asistió' : 'asistieron'}`}
        {(estado || soloMias) && ` · ${citas.length} con este filtro`}
      </p>
    </div>
    <div class="acciones">
      {
        esDoctora && (
          <a class="btn btn--ghost btn--chico" href="/admin/integracion/google">
            <Icono nombre="sincronizar" tam={16} />
            {!integracionActiva
              ? 'Google Calendar'
              : sinSincronizar > 0
                ? `Google · ${sinSincronizar} sin sincronizar`
                : 'Google Calendar · al día'}
          </a>
        )
      }
      <a class="btn btn--primary btn--chico" href={`/admin/agenda/nueva?dia=${dia}`}>
        <Icono nombre="mas" tam={16} /> Nueva cita
      </a>
    </div>
  </div>

  {
    fallo && (
      <p class="aviso aviso--error" role="alert">
        <Icono nombre="alerta" />
        <span class="aviso__texto">{fallo}</span>
      </p>
    )
  }
  {
    errorGuardar && (
      <p class="aviso aviso--error" role="alert">
        <Icono nombre="alerta" />
        <span class="aviso__texto">No se pudo guardar. Inténtalo otra vez.</span>
      </p>
    )
  }
  {
    guardado && (
      <p class="aviso aviso--ok" role="status">
        <Icono nombre="hecho" />
        <span class="aviso__texto">Guardado.</span>
      </p>
    )
  }

  {
    integracionActiva && sinSincronizar > 0 && (
      /* Nunca se pierde una cita por un fallo de Google: se guarda igual y se
         reintenta desde aquí, a mano y cuando se quiera. */
      <div class="aviso aviso--aviso aviso--accion" role="status">
        <Icono nombre="sincronizar" />
        <span class="aviso__texto">
          {sinSincronizar === 1
            ? 'Hay 1 cita guardada que todavía no está en Google Calendar.'
            : `Hay ${sinSincronizar} citas guardadas que todavía no están en Google Calendar.`}
        </span>
        <form method="post">
          <input type="hidden" name="accion" value="sincronizar" />
          <button class="btn btn--ghost btn--chico" type="submit">Reintentar</button>
        </form>
      </div>
    )
  }

  <div class="agenda-barra">
    <div class="agenda-nav">
      <a
        class="icbtn"
        href={enlace({ dia: sumarDias(dia, -salto), cita: undefined })}
        aria-label={vista === 'semana' ? 'Semana anterior' : 'Día anterior'}
      >
        <Icono nombre="izquierda" />
      </a>
      <a class="btn btn--ghost btn--chico" href={enlace({ dia: hoy, cita: undefined })}>Hoy</a>
      <a
        class="icbtn"
        href={enlace({ dia: sumarDias(dia, salto), cita: undefined })}
        aria-label={vista === 'semana' ? 'Semana siguiente' : 'Día siguiente'}
      >
        <Icono nombre="derecha" />
      </a>
      <nav class="seg" aria-label="Vista de la agenda" style="margin-left: 6px">
        <a href={enlace({ vista: 'dia' })} aria-current={vista === 'dia' ? 'true' : undefined}>Día</a>
        <a
          class="agenda-vista-semana"
          href={enlace({ vista: 'semana' })}
          aria-current={vista === 'semana' ? 'true' : undefined}>Semana</a
        >
      </nav>
    </div>

    <nav class="fchips" aria-label="Filtrar citas">
      <a class="fchip" href={enlace({ estado: undefined })} aria-current={!estado ? 'true' : undefined}>
        Todas <span class="fchip__n">{todas.length}</span>
      </a>
      {
        ESTADOS_CITA.filter((e) => cuenta[e] > 0 || e === estado).map((e) => (
          <a class="fchip" href={enlace({ estado: e })} aria-current={e === estado ? 'true' : undefined}>
            {ETIQUETA_ESTADO_CITA[e]} <span class="fchip__n">{cuenta[e]}</span>
          </a>
        ))
      }
      <a
        class="fchip"
        href={enlace({ mias: soloMias ? undefined : '1' })}
        aria-current={soloMias ? 'true' : undefined}
      >
        <Icono nombre="paciente" tam={16} /> Solo las mías
      </a>
    </nav>
  </div>

  {/* En el teléfono la semana no cabe: se elige el día aquí. */}
  <nav class="dias-movil" aria-label="Días de la semana">
    {
      diasSemana.map((d) => {
        const n = semanaEntera.filter((c) => diaEnMexico(c.inicia_en) === d && c.estado !== 'cancelada').length;
        return (
          <a href={enlace({ dia: d, vista: 'dia', cita: undefined })} aria-current={d === dia && vista === 'dia' ? 'true' : undefined}>
            <span>{diaCortoConNumero(d).split(' ')[0]}</span>
            <b>{d.slice(8).replace(/^0/, '')}</b>
            <span>{n} {n === 1 ? 'cita' : 'citas'}</span>
          </a>
        );
      })
    }
  </nav>

  <div class="agenda-layout">
    <div class="columna" style="gap: 12px">
      <section
        class={`panel rejilla ${vista === 'semana' ? 'rejilla--semana' : ''}`}
        aria-label={vista === 'semana' ? 'Citas de la semana por hora' : 'Citas del día por hora'}
      >
        {
          vista === 'semana' && (
            <div class="rejilla__dias">
              <div />
              {diasSemana.map((d) => (
                <div class={`rejilla__dia ${d === hoy ? 'rejilla__dia--hoy' : ''}`}>
                  <a href={enlace({ dia: d, vista: 'dia', cita: undefined })}>
                    {diaCortoConNumero(d).split(' ')[0]}
                    <b>{d.slice(8).replace(/^0/, '')}</b>
                  </a>
                </div>
              ))}
            </div>
          )
        }
        <div class="rejilla__cuerpo">
          <div class="rejilla__horas" aria-hidden="true">
            {
              HORAS_REJILLA.map((h) => (
                <span class="rejilla__h" style={`top: ${((h - APERTURA) / (CIERRE - APERTURA)) * 100}%`}>
                  {h}:00
                </span>
              ))
            }
          </div>
          {
            columnas.map((col) => (
              <div class="rejilla__col">
                {col.cerrado !== null && (
                  <div class="rejilla__cerrado" style={`top: ${col.cerrado}%`}>
                    Cerrado
                  </div>
                )}
                {col.bloques.map((b) => (
                  <a
                    class={claseBloque(b)}
                    style={`top: ${b.top}%; height: ${b.alto}%`}
                    href={enlace({ cita: b.cita.id })}
                    data-cita={b.cita.id}
                  >
                    <span class="bloque__t">
                      {b.cita.estado === 'atendida' || b.cita.estado === 'confirmada' ? (
                        <Icono nombre="hecho" tam={16} />
                      ) : b.cita.estado === 'no_asistio' ? (
                        <Icono nombre="cerrar" tam={16} />
                      ) : null}
                      {b.desde}
                      {!b.corto && `–${b.hasta}`}
                    </span>
                    <span class="bloque__n">{b.cita.nombre_contacto}</span>
                    {b.corto ? (
                      <span class="bloque__s bloque__estado">· {ETIQUETA_ESTADO_CITA[b.cita.estado]}</span>
                    ) : (
                      <span class="bloque__s">
                        {ETIQUETA_TIPO_CITA[b.cita.tipo]} · {ETIQUETA_ESTADO_CITA[b.cita.estado]}
                      </span>
                    )}
                  </a>
                ))}
                {col.dia === hoy && ahora && (
                  <div class="ahora" style={`top: ${ahora.top}%`}>
                    <span>{ahora.texto}</span>
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </section>

      {
        fuera.length > 0 && (
          <div class="aviso aviso--info">
            <Icono nombre="reloj" />
            <span class="aviso__texto">
              <b>Fuera de horario</b>
              {fuera.map((c, i) => (
                <>
                  {i === 0 ? ' · ' : ', '}
                  <a href={enlace({ cita: c.id })}>
                    {vista === 'semana' ? fechaHora(c.inicia_en) : hora(c.inicia_en)} {c.nombre_contacto}
                  </a>
                </>
              ))}
            </span>
          </div>
        )
      }

      <div class="leyenda" aria-hidden="true">
        <span><i style="background: var(--clay-50); border-color: var(--clay-200)" />Valoración</span>
        <span><i style="background: var(--teal-50); border-color: var(--teal-200)" />Control</span>
        <span><i style="background: var(--bad-50); border-color: var(--bad-200)" />No asistió</span>
        <span>
          <i style="background: repeating-linear-gradient(135deg, var(--neutral-50) 0 3px, var(--surface) 3px 6px); border-color: var(--line)" />
          Cancelada
        </span>
      </div>
    </div>

    <aside class="agenda-lateral" aria-label={elegida ? 'Detalle de la cita' : 'Resumen'} id="detalle">
      {
        elegida ? (
          <>
            <section class="panel">
              <div class="panel__cabecera" style="margin-bottom: 8px">
                <span class={`chip chip--cita-${elegida.estado}`}>{ETIQUETA_ESTADO_CITA[elegida.estado]}</span>
                <a class="icbtn" href={enlace({ cita: undefined })} aria-label="Cerrar el detalle">
                  <Icono nombre="cerrar" />
                </a>
              </div>
              <h2 class="panel__titulo" style="font-size: 26px; margin-bottom: 4px">
                {elegida.nombre_contacto}
              </h2>
              <p class="tabla__sec" style="font-size: 14px">
                {ETIQUETA_TIPO_CITA[elegida.tipo]} · {fechaHora(elegida.inicia_en)} · {elegida.duracion_min} min
              </p>
              <dl class="datos" style="margin-top: 16px">
                {elegida.telefono_contacto && (
                  <>
                    <dt>Teléfono</dt>
                    <dd>{elegida.telefono_contacto}</dd>
                  </>
                )}
                <dt>De quién</dt>
                <dd>
                  {elegida.solicitud_id ? (
                    <a href={`/admin/prospectos/${elegida.solicitud_id}`}>Prospecto</a>
                  ) : elegida.paciente_id ? (
                    esDoctora ? (
                      <a href={`/admin/pacientes/${elegida.paciente_id}`}>Paciente</a>
                    ) : (
                      'Paciente en tratamiento'
                    )
                  ) : (
                    'Sin ficha'
                  )}
                </dd>
                {elegida.google_sync !== 'desactivada' && (
                  <>
                    <dt>Google</dt>
                    <dd>
                      {elegida.google_sync === 'sincronizada' ? (
                        <span class="chip chip--ok">Sincronizada</span>
                      ) : (
                        <span class="chip chip--sync">Sin sincronizar</span>
                      )}
                    </dd>
                  </>
                )}
                {elegida.nota && (
                  <>
                    <dt>Nota</dt>
                    <dd>{elegida.nota}</dd>
                  </>
                )}
              </dl>
              <div class="acciones" style="margin-top: 18px">
                {elegida.telefono_contacto && (
                  <>
                    <a
                      class="btn btn--ghost btn--chico"
                      href={aWhatsappCita(elegida.telefono_contacto, elegida.nombre_contacto, fechaHora(elegida.inicia_en))}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <Icono nombre="whatsapp" tam={16} /> WhatsApp
                    </a>
                    <a class="btn btn--ghost btn--chico" href={aTelefono(elegida.telefono_contacto)}>
                      <Icono nombre="telefono" tam={16} /> Llamar
                    </a>
                  </>
                )}
                <a class="btn btn--ghost btn--chico" href={`/admin/agenda/${elegida.id}`}>
                  Editar o reprogramar
                </a>
              </div>

              <form method="post" class="campos-2" style="margin-top: 18px; align-items: end">
                <input type="hidden" name="accion" value="estado" />
                <input type="hidden" name="id" value={elegida.id} />
                <div class="field" style="margin-bottom: 0">
                  <label for="asistencia">Asistencia</label>
                  <select id="asistencia" name="estado">
                    {ESTADOS_CITA.map((valor) => (
                      <option value={valor} selected={valor === elegida?.estado}>
                        {ETIQUETA_ESTADO_CITA[valor]}
                      </option>
                    ))}
                  </select>
                </div>
                <button class="btn btn--primary btn--chico" type="submit" style="min-height: 48px">
                  Guardar asistencia
                </button>
              </form>
            </section>

            {ofrecerConversion && (
              <section class="panel panel--tinta">
                <span class="eyebrow-panel" style="color: var(--teal-600)">Siguiente paso</span>
                <h2 class="panel__titulo" style="margin: 6px 0 8px">¿Aceptó el tratamiento?</h2>
                <p class="panel__texto">
                  La valoración quedó como atendida. Si decide empezar, crea su ficha: el prospecto
                  pasa a terminado sin perder su historial.
                </p>
                <a class="btn btn--primary btn--block" href={`/admin/prospectos/${elegida.solicitud_id}/convertir`}>
                  <Icono nombre="convertir" /> Convertir en paciente
                </a>
                <a
                  class="btn btn--ghost btn--chico btn--block"
                  href={`/admin/prospectos/${elegida.solicitud_id}#seguimiento`}
                  style="margin-top: 8px"
                >
                  Todavía no · poner seguimiento
                </a>
              </section>
            )}
            {yaPaciente && (
              <p class="aviso aviso--ok">
                <Icono nombre="hecho" />
                <span class="aviso__texto">
                  Ya es paciente: <a href={`/admin/pacientes/${yaPaciente.id}`}>{yaPaciente.nombre}</a>
                </span>
              </p>
            )}
          </>
        ) : (
          <section class="panel">
            <h2 class="panel__titulo">{vista === 'semana' ? 'Esta semana' : 'Este día'}</h2>
            {vivas.length === 0 ? (
              <div class="vacio vacio--linea">
                <p>Sin citas {vista === 'semana' ? 'esta semana' : 'este día'}.</p>
                <a class="btn btn--ghost btn--chico" href={`/admin/agenda/nueva?dia=${dia}`} style="margin-top: 12px">
                  <Icono nombre="mas" tam={16} /> Agendar una
                </a>
              </div>
            ) : (
              <>
                {proxima && (
                  <a class="cita-destacada panel--tinta" href={enlace({ cita: proxima.id })} style="border: 1px solid var(--teal-200)">
                    <span class="cola__icono ic-pizarra">
                      <Icono nombre="reloj" />
                    </span>
                    <span style="flex: 1; min-width: 0">
                      <span class="eyebrow-panel">Siguiente</span>
                      <b style="display: block; color: var(--ink)">{proxima.nombre_contacto}</b>
                      <span class="tabla__sec">
                        {ETIQUETA_TIPO_CITA[proxima.tipo]} · {vista === 'semana' ? fechaHora(proxima.inicia_en) : hora(proxima.inicia_en)}
                      </span>
                    </span>
                  </a>
                )}
                <dl class="datos" style="margin-top: 16px">
                  {ESTADOS_CITA.filter((e) => cuenta[e] > 0).map((e) => (
                    <>
                      <dt>{ETIQUETA_ESTADO_CITA[e]}</dt>
                      <dd class="num">{cuenta[e]}</dd>
                    </>
                  ))}
                </dl>
                <p class="panel__nota">Toca una cita de la rejilla para ver su detalle y marcar la asistencia.</p>
              </>
            )}
          </section>
        )
      }
    </aside>
  </div>
</AdminLayout>
