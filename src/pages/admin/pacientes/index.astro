---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Icono from '@/components/admin/Icono.astro';
import {
  contarPorEstado,
  esEstadoPaciente,
  idsConAdeudo,
  listar,
  resumenes,
  type PacienteListado,
  type ResumenPaciente,
} from '@/lib/pacientes';
import { dinero } from '@/lib/formato';
import { fechaHora } from '@/lib/tiempo';
import {
  ESTADOS_PACIENTE,
  ETIQUETA_ESTADO_PACIENTE,
  type EstadoPaciente,
} from '@/lib/supabase/tipos';

export const prerender = false;

/** Plural para los chips de filtro. */
const PLURAL: Record<EstadoPaciente, string> = {
  activo: 'Activos',
  retencion: 'En retención',
  pausado: 'Pausados',
  alta: 'Alta',
};

const supabase = Astro.locals.supabase;
const params = Astro.url.searchParams;
const estadoParam = params.get('estado');
const estado = esEstadoPaciente(estadoParam) ? estadoParam : undefined;
const busqueda = params.get('q')?.trim() ?? '';
const conAdeudo = params.get('adeudo') === '1';

let pacientes: PacienteListado[] = [];
let resumen = new Map<string, ResumenPaciente>();
let porEstado: Record<EstadoPaciente, number> = { activo: 0, retencion: 0, pausado: 0, alta: 0 };
let adeudo: string[] = [];
let fallo: string | null = null;

try {
  [porEstado, adeudo] = await Promise.all([contarPorEstado(supabase), idsConAdeudo(supabase)]);
  pacientes = await listar(supabase, { estado, busqueda, ids: conAdeudo ? adeudo : undefined });
  resumen = await resumenes(
    supabase,
    pacientes.map((p) => p.id)
  );
} catch (e) {
  console.error('[admin] listado de pacientes falló:', e instanceof Error ? e.message : 'desconocido');
  fallo = 'No pudimos cargar los pacientes. Vuelve a intentarlo en un momento.';
}

const total = Object.values(porEstado).reduce((t, n) => t + n, 0);
const hayFiltro = !!estado || !!busqueda || conAdeudo;

function enlace(cambios: Record<string, string | undefined>): string {
  const nuevos = new URLSearchParams(params);
  for (const [clave, valor] of Object.entries(cambios)) {
    if (valor === undefined) nuevos.delete(clave);
    else nuevos.set(clave, valor);
  }
  const cadena = nuevos.toString();
  return `/admin/pacientes${cadena ? `?${cadena}` : ''}`;
}
---

<AdminLayout title="Pacientes" seccion="pacientes">
  <div class="admin-head">
    <div>
      <h1>Pacientes</h1>
      <p>
        {
          fallo
            ? 'Sin datos'
            : `${porEstado.activo} ${porEstado.activo === 1 ? 'activo' : 'activos'} · ${porEstado.retencion} en retención · ${adeudo.length} con cuota vencida`
        }
        {
          hayFiltro && (
            <>
              {' · '}
              <a class="admin-head__quitar" href="/admin/pacientes">
                Quitar filtro
              </a>
            </>
          )
        }
      </p>
    </div>

    <div class="admin-head__derecha">
      <form class="filtros" method="get" action="/admin/pacientes" role="search">
        {estado && <input type="hidden" name="estado" value={estado} />}
        {conAdeudo && <input type="hidden" name="adeudo" value="1" />}
        <div class="field buscador">
          <label class="visualmente-oculto" for="q">Buscar</label>
          <Icono nombre="buscar" />
          <input id="q" name="q" type="search" value={busqueda} placeholder="Nombre o teléfono" />
        </div>
        <button class="btn btn--ghost btn--chico" type="submit">Filtrar</button>
      </form>
      <a class="btn btn--primary btn--chico" href="/admin/pacientes/nuevo">
        <Icono nombre="mas" tam={16} /> Nuevo paciente
      </a>
    </div>
  </div>

  {
    fallo && (
      <p class="aviso aviso--error" role="alert">
        <Icono nombre="alerta" />
        <span class="aviso__texto">{fallo}</span>
      </p>
    )
  }

  <nav class="fchips" aria-label="Filtrar pacientes">
    <a class="fchip" href={enlace({ estado: undefined })} aria-current={!estado ? 'true' : undefined}>
      Todos <span class="fchip__n">{total}</span>
    </a>
    {
      ESTADOS_PACIENTE.map((valor) => (
        <a class="fchip" href={enlace({ estado: valor })} aria-current={valor === estado ? 'true' : undefined}>
          {PLURAL[valor]} <span class="fchip__n">{porEstado[valor]}</span>
        </a>
      ))
    }
    <a
      class="fchip fchip--peligro"
      href={enlace({ adeudo: conAdeudo ? undefined : '1' })}
      aria-current={conAdeudo ? 'true' : undefined}
    >
      <Icono nombre="alerta" tam={16} /> Con cuota vencida <span class="fchip__n">{adeudo.length}</span>
    </a>
  </nav>

  <div class="panel panel--lista panel--tarjetas">
    {
      pacientes.length === 0 && !fallo ? (
        <div class="vacio">
          <strong>{hayFiltro ? 'Nada con ese filtro' : 'Todavía no hay pacientes'}</strong>
          <p>
            {hayFiltro
              ? total > 0
                ? `Hay ${total} ${total === 1 ? 'paciente' : 'pacientes'} en total, pero ninguno coincide con lo que estás filtrando.`
                : 'Prueba a quitar el filtro o a buscar otra cosa.'
              : 'Un prospecto se convierte en paciente desde su ficha, cuando acepta el tratamiento.'}
          </p>
          <div class="acciones" style="margin-top: 20px; justify-content: center">
            {hayFiltro ? (
              <a class="btn btn--primary btn--chico" href="/admin/pacientes">
                Ver todos los pacientes
              </a>
            ) : (
              <>
                <a class="btn btn--primary btn--chico" href="/admin/pacientes/nuevo">
                  + Nuevo paciente
                </a>
                <a class="btn btn--ghost btn--chico" href="/admin/prospectos">
                  Ver prospectos
                </a>
              </>
            )}
          </div>
        </div>
      ) : (
        <div class="tabla-scroll">
          <table class="tabla">
            <thead>
              <tr>
                <th>Paciente</th>
                <th>Avance</th>
                <th>Próxima cita</th>
                <th class="tabla__num">Saldo</th>
                <th>Pagos</th>
              </tr>
            </thead>
            <tbody>
              {pacientes.map((p) => {
                const r = resumen.get(p.id);
                const pagadas = r?.cuotasPagadas ?? 0;
                const numCuotas = r?.numCuotas ?? 0;
                // Sin `<=`: dentro de la plantilla, el parser de Astro lo toma por una etiqueta.
                const saldoCero = !!r?.tienePlan && !(Number(r.saldo) > 0);
                return (
                  <tr class={r && r.cuotasVencidas > 0 ? 'tabla__urgente' : undefined}>
                    <td>
                      <a class="tabla__nombre" href={`/admin/pacientes/${p.id}`}>
                        {p.nombre}
                      </a>
                      <span class="tabla__sec">
                        {p.tratamiento}
                        {p.estado !== 'activo' && (
                          <>
                            {' · '}
                            <span class={`chip chip--chico chip--${p.estado}`}>{ETIQUETA_ESTADO_PACIENTE[p.estado]}</span>
                          </>
                        )}
                      </span>
                    </td>
                    <td class="tabla__meta" style="min-width: 170px">
                      {r?.tienePlan && numCuotas > 0 ? (
                        <>
                          <span>
                            {pagadas} de {numCuotas} mensualidades
                          </span>
                          <div class="barra" aria-hidden="true">
                            <i style={`width: ${Math.min(100, (pagadas / numCuotas) * 100)}%`} />
                          </div>
                        </>
                      ) : r?.tienePlan ? (
                        'Sin calendario'
                      ) : (
                        <a href={`/admin/pacientes/${p.id}/plan`}>Crear plan</a>
                      )}
                    </td>
                    <td class="tabla__meta tabla__nowrap">
                      {r?.proximaCita ? (
                        <span class="num">{fechaHora(r.proximaCita)}</span>
                      ) : (
                        <a href={`/admin/agenda/nueva?paciente=${p.id}`}>+ Agendar</a>
                      )}
                    </td>
                    <td class="tabla__num">{r?.tienePlan ? dinero(r.saldo) : '—'}</td>
                    <td class="tabla__estado">
                      {!r?.tienePlan ? (
                        <span class="chip chip--neutro">Sin plan</span>
                      ) : r.cuotasVencidas > 0 ? (
                        <span class="chip chip--vencida">
                          {r.cuotasVencidas} {r.cuotasVencidas === 1 ? 'vencida' : 'vencidas'}
                        </span>
                      ) : saldoCero ? (
                        <span class="chip chip--ok">Liquidado</span>
                      ) : (
                        <span class="chip chip--ok">Al corriente</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
</AdminLayout>
