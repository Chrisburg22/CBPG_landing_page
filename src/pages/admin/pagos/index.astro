---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { dinero, dineroCorto, fechaCorta, hoyEnMexico, sumar } from '@/lib/formato';
import {
  borrar,
  esTipoPago,
  limitesDelMes,
  listarMovimientos,
  porCobrar,
  type MovimientoPago,
} from '@/lib/pagos';
import { aWhatsappCobro, registrarRecordatorio, ultimoPorCuota } from '@/lib/cobranza';
import { diaEnMexico } from '@/lib/tiempo';
import {
  ETIQUETA_METODO_PAGO,
  ETIQUETA_TIPO_PAGO,
  TIPOS_PAGO,
  type RecordatorioCobro,
} from '@/lib/supabase/tipos';

export const prerender = false;

// Borrar un pago mal registrado, o dejar constancia de un recordatorio de cobro.
// POST-Redirect-GET como el resto del panel.
if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const accion = String(datos.get('accion') ?? 'borrar');
  const id = String(datos.get('id') ?? '');
  try {
    if (accion === 'recordatorio') {
      // La aplicación no manda el mensaje: lo manda la doctora desde su
      // teléfono. Lo único que se registra es que lo dio por enviado, que es
      // lo que evita cobrarle dos veces a la misma persona.
      await registrarRecordatorio(Astro.locals.supabase, {
        cuotaId: id,
        pacienteId: String(datos.get('paciente') ?? ''),
      });
    } else if (id) {
      await borrar(Astro.locals.supabase, id);
    }
  } catch (e) {
    console.error('[admin] no se pudo guardar:', e instanceof Error ? e.message : 'desconocido');
    return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 303);
  }
  return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`, 303);
}

const params = Astro.url.searchParams;

/** 'AAAA-MM' del selector de periodo; por defecto, el mes en curso. */
const mesParam = params.get('mes');
const mes = /^\d{4}-\d{2}$/.test(mesParam ?? '') ? mesParam! : hoyEnMexico().slice(0, 7);
const { desde, hasta } = limitesDelMes(`${mes}-01`);

const tipoParam = params.get('tipo');
const tipo = esTipoPago(tipoParam) ? tipoParam : undefined;

let movimientos: MovimientoPago[] = [];
let pendientes: Awaited<ReturnType<typeof porCobrar>> = [];
let nombresPaciente = new Map<string, string>();
let telefonos = new Map<string, string>();
let recordatorios = new Map<string, RecordatorioCobro>();
let fallo: string | null = null;

try {
  [movimientos, pendientes] = await Promise.all([
    listarMovimientos(Astro.locals.supabase, { desde, hasta, tipo }),
    porCobrar(Astro.locals.supabase, 20),
  ]);

  const ids = [...new Set(pendientes.map((c) => c.paciente_id))];
  if (ids.length > 0) {
    const { data } = await Astro.locals.supabase
      .from('pacientes')
      .select('id, nombre, telefono')
      .in('id', ids);
    nombresPaciente = new Map((data ?? []).map((p) => [p.id, p.nombre]));
    telefonos = new Map((data ?? []).map((p) => [p.id, p.telefono]));
    recordatorios = await ultimoPorCuota(
      Astro.locals.supabase,
      pendientes.map((c) => c.id)
    );
  }
} catch (e) {
  console.error('[admin] no se pudieron cargar los pagos:', e instanceof Error ? e.message : 'desconocido');
  fallo = 'No pudimos cargar los pagos. Vuelve a intentarlo en un momento.';
}

const cobrado = sumar(movimientos.map((m) => m.monto));
const vencidas = pendientes.filter((c) => c.estado === 'vencida');
const montoVencido = sumar(vencidas.map((c) => c.restante));

/** Los últimos doce meses para el selector, con su etiqueta legible. */
const meses = Array.from({ length: 12 }, (_, i) => {
  const d = new Date();
  d.setDate(1);
  d.setMonth(d.getMonth() - i);
  const valor = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  const etiqueta = d.toLocaleDateString('es-MX', { month: 'long', year: 'numeric' });
  return { valor, etiqueta: etiqueta.charAt(0).toLocaleUpperCase('es-MX') + etiqueta.slice(1) };
});
---

<AdminLayout title="Pagos" seccion="pagos">
  <div class="admin-head">
    <div>
      <h1>Pagos</h1>
      <p>Mensualidades del plan y cargos sueltos</p>
    </div>
    <div class="admin-head__derecha">
      <form class="filtros" method="get" action="/admin/pagos">
      <div class="field">
        <label for="mes">Periodo</label>
        <select id="mes" name="mes">
          {meses.map((m) => <option value={m.valor} selected={m.valor === mes}>{m.etiqueta}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="tipo">Tipo</label>
        <select id="tipo" name="tipo">
          <option value="">Todos</option>
          {
            TIPOS_PAGO.map((valor) => (
              <option value={valor} selected={valor === tipo}>
                {ETIQUETA_TIPO_PAGO[valor]}
              </option>
            ))
          }
        </select>
      </div>
        <button class="btn btn--ghost btn--chico" type="submit">Filtrar</button>
      </form>
      <a class="btn btn--primary btn--chico admin-head__accion" href="/admin/pagos/nuevo">
      + Registrar pago
      </a>
    </div>
  </div>

  {fallo && <p class="aviso aviso--error">{fallo}</p>}

  {
    !fallo && (
      <div class="metricas">
        <div class="metrica">
          <span class="metrica__k">Cobrado</span>
          <span class="metrica__v">{dineroCorto(cobrado)}</span>
          <span class="metrica__d">
            {movimientos.length} {movimientos.length === 1 ? 'movimiento' : 'movimientos'}
          </span>
        </div>
        <div class="metrica">
          <span class="metrica__k">Vencido</span>
          <span class="metrica__v">{montoVencido > 0 ? dineroCorto(montoVencido) : '—'}</span>
          <span class={vencidas.length > 0 ? 'metrica__d metrica__d--alta' : 'metrica__d metrica__d--ok'}>
            {vencidas.length > 0
              ? `${vencidas.length} ${vencidas.length === 1 ? 'cuota' : 'cuotas'}`
              : 'Nada vencido'}
          </span>
        </div>
      </div>
    )
  }

  {
    !fallo && pendientes.length > 0 && (
      <div class="panel panel--lista">
        <div class="panel__cabecera">
          <h2 class="panel__titulo">Por cobrar</h2>
        </div>
        <div class="tabla-scroll">
          <table class="tabla">
            <thead>
              <tr>
                <th>Paciente</th>
                <th>Concepto</th>
                <th>Vence</th>
                <th class="tabla__num">Falta</th>
                <th>Recordatorio</th>
                <th><span class="visualmente-oculto">Registrar</span></th>
              </tr>
            </thead>
            <tbody>
              {pendientes.map((c) => {
                const nombre = nombresPaciente.get(c.paciente_id) ?? 'Paciente';
                const telefono = telefonos.get(c.paciente_id) ?? '';
                const aviso = recordatorios.get(c.id);
                return (
                <tr>
                  <td>
                    <a class="tabla__nombre" href={`/admin/pacientes/${c.paciente_id}`}>
                      {nombre}
                    </a>
                  </td>
                  <td class="tabla__meta">Mensualidad {c.numero}</td>
                  <td class="tabla__fecha tabla__meta">
                    {c.estado === 'vencida' ? (
                      <span class="chip chip--vencida">Venció {fechaCorta(c.vence_el)}</span>
                    ) : (
                      fechaCorta(c.vence_el)
                    )}
                  </td>
                  <td class="tabla__num">{dinero(c.restante)}</td>
                  <td class="tabla__accion tabla__accion--doble">
                    {/* El mensaje se manda a mano desde WhatsApp; el botón de
                        al lado solo deja constancia de que se mandó. Separados
                        a propósito: la aplicación no puede saber si el enlace
                        acabó en un mensaje enviado, y fingir que sí llevaría a
                        dar por cobrado lo que nadie mandó. */}
                    {telefono && (
                      <a
                        class="btn btn--primary btn--chico"
                        href={aWhatsappCobro(telefono, {
                          nombre,
                          numero: c.numero,
                          restante: c.restante,
                          venceEl: c.vence_el,
                          vencida: c.estado === 'vencida',
                        })}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        WhatsApp
                      </a>
                    )}
                    <form method="post">
                      <input type="hidden" name="accion" value="recordatorio" />
                      <input type="hidden" name="id" value={c.id} />
                      <input type="hidden" name="paciente" value={c.paciente_id} />
                      <button class="estado-rapido__ok" type="submit">
                        Marcar recordatorio enviado
                      </button>
                    </form>
                    {aviso && (
                      <span class="tabla__sec">
                        Último: {fechaCorta(diaEnMexico(aviso.creado_en))}
                      </span>
                    )}
                  </td>
                  <td class="tabla__accion">
                    <a
                      class="btn btn--ghost btn--chico"
                      href={`/admin/pagos/nuevo?cuota=${c.id}`}
                    >
                      Registrar
                    </a>
                  </td>
                </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )
  }

  {
    !fallo && (
      <div class="panel panel--lista">
        <div class="panel__cabecera">
          <h2 class="panel__titulo">Movimientos</h2>
        </div>

        {movimientos.length === 0 ? (
          <div class="vacio">
            <strong>Sin movimientos en este periodo</strong>
            <p>
              Los pagos que registres aparecerán aquí, agrupados por el mes en que se
              cobraron.
            </p>
            <a class="btn btn--primary btn--chico" href="/admin/pagos/nuevo" style="margin-top: 20px">
              + Registrar pago
            </a>
          </div>
        ) : (
          <div class="tabla-scroll">
            <table class="tabla">
              <thead>
                <tr>
                  <th>Paciente</th>
                  <th>Concepto</th>
                  <th>Fecha</th>
                  <th class="tabla__num">Monto</th>
                  <th><span class="visualmente-oculto">Quitar</span></th>
                </tr>
              </thead>
              <tbody>
                {movimientos.map((m) => (
                  <tr>
                    <td>
                      <a class="tabla__nombre" href={`/admin/pacientes/${m.paciente_id}`}>
                        {m.pacientes?.nombre ?? 'Paciente'}
                      </a>
                      <span class="tabla__sec">{ETIQUETA_TIPO_PAGO[m.tipo]}</span>
                    </td>
                    <td class="tabla__meta">
                      {m.concepto || '—'}
                      <span class="tabla__sec">{ETIQUETA_METODO_PAGO[m.metodo]}</span>
                    </td>
                    <td class="tabla__fecha tabla__meta">{fechaCorta(m.pagado_el)}</td>
                    <td class="tabla__num">{dinero(m.monto)}</td>
                    <td class="tabla__accion">
                      {/* Un pago mal tecleado hay que poder quitarlo. La confirmación
                          la pide el navegador; sin JavaScript el botón borra directo,
                          que es preferible a no poder corregir nada. */}
                      <form method="post" data-confirmar={`Quitar el pago de ${dinero(m.monto)}?`}>
                        <input type="hidden" name="id" value={m.id} />
                        <button class="estado-rapido__ok" type="submit">Quitar</button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    )
  }

  <script is:inline>
    document.getElementById('mes')?.addEventListener('change', (e) => e.target.form.submit());
    document.getElementById('tipo')?.addEventListener('change', (e) => e.target.form.submit());

    for (const form of document.querySelectorAll('[data-confirmar]')) {
      form.addEventListener('submit', (e) => {
        if (!confirm(form.dataset.confirmar)) e.preventDefault();
      });
    }
  </script>
</AdminLayout>
