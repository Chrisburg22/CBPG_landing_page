---
/**
 * Redirección permanente: la ficha vivía aquí cuando el panel tenía una sola
 * sección. Se queda para no romper los enlaces que la doctora tenga guardados.
 *
 * Es una página y no una entrada en `redirects` de astro.config porque con
 * `output: 'static'` esa vía genera HTML estático bajo /admin, que es
 * exactamente lo que `scripts/verificar-build.mjs` prohíbe.
 */
export const prerender = false;

// Sin variable intermedia: `astro check` marca como no usada cualquier local
// que solo se lea dentro del `return` de un frontmatter sin plantilla.
return Astro.redirect(`/admin/prospectos/${Astro.params.id ?? ''}`, 301);
---
