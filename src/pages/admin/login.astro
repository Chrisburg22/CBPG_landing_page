---
import AdminLayout from '@/layouts/AdminLayout.astro';

export const prerender = false;

const params = Astro.url.searchParams;
const enviado = params.get('enviado') === '1';
const salio = params.get('salir') === '1';
const error = params.get('error');
---

<AdminLayout title="Acceso" conBarra={false}>
  <div class="acceso">
    <form class="panel" method="post" action="/admin/auth/enviar-enlace">
      <h1>Panel de solicitudes</h1>
      <p class="acceso__desc">
        Escribe tu correo y te mandamos un enlace para entrar. No hay contraseña que recordar.
      </p>

      {
        enviado && (
          <p class="aviso aviso--ok">
            Si ese correo tiene acceso, el enlace ya va en camino. Revisa tu bandeja —
            y la carpeta de no deseados. El enlace caduca en una hora.
          </p>
        )
      }
      {salio && <p class="aviso aviso--info">Cerraste sesión.</p>}
      {
        error === 'envio' && (
          <p class="aviso aviso--error">
            No pudimos mandar el enlace. Inténtalo de nuevo en unos minutos.
          </p>
        )
      }
      {
        error === 'enlace' && (
          <p class="aviso aviso--error">
            Ese enlace ya no sirve: caducó, ya se usó, o lo abriste en un navegador
            distinto al que lo pidió. Pide uno nuevo.
          </p>
        )
      }

      <div class="field">
        <label for="email">Correo</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          placeholder="tucorreo@ejemplo.com"
        />
      </div>

      <button class="btn btn--primary btn--block" type="submit">Enviarme el enlace</button>
    </form>
  </div>
</AdminLayout>
