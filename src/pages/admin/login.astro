---
import AdminLayout from '@/layouts/AdminLayout.astro';

export const prerender = false;

const params = Astro.url.searchParams;
const salio = params.get('salir') === '1';
const error = params.get('error');
---

<AdminLayout title="Acceso" conBarra={false}>
  <div class="acceso">
    <form class="panel" method="post" action="/admin/auth/entrar">
      <h1>Panel de solicitudes</h1>
      <p class="acceso__desc">Entra con tu correo y contraseña.</p>

      {salio && <p class="aviso aviso--info">Cerraste sesión.</p>}
      {
        error === 'credenciales' && (
          <p class="aviso aviso--error">
            Correo o contraseña incorrectos. Revísalos e inténtalo de nuevo.
          </p>
        )
      }

      <div class="field">
        <label for="email">Correo</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="username"
          inputmode="email"
          placeholder="tucorreo@ejemplo.com"
        />
      </div>

      <div class="field">
        <label for="password">Contraseña</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
        />
      </div>

      <button class="btn btn--primary btn--block" type="submit">Entrar</button>
    </form>
  </div>

  {/* La purga de la caché va aquí y no en el botón «Salir» de AdminLayout: ese
      botón es un <form method="post">, y la página que lo envía está siendo
      desmontada, así que un caches.delete() disparado desde el submit compite
      con la navegación sin garantía de completarse. Convertirlo en fetch
      rompería el flujo sin JS y la postura de CSRF, que cubre formularios y no
      JSON (probado en e2e/seguridad.spec.ts).

      /admin/auth/salir siempre redirige aquí con ?salir=1, así que este es el
      único punto por el que pasa todo cierre de sesión, y es idempotente.

      Lo que se borra son activos de compilación e iconos: el worker no guarda
      datos de paciente nunca. Esto es higiene y red de seguridad ante un cambio
      futuro, no confidencialidad. */}
  <script is:inline>
    if (new URLSearchParams(location.search).get('salir') === '1' && 'caches' in window) {
      // No se toca `panel-respaldo-*` ni se desregistra el worker: eso dejaría
      // el panel sin modo sin conexión hasta el siguiente registro.
      caches.keys().then((nombres) =>
        Promise.all(
          nombres.filter((n) => n.startsWith('panel-runtime-')).map((n) => caches.delete(n))
        )
      );
    }
  </script>
</AdminLayout>
